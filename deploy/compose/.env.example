# ── Domains (must resolve to this server; Caddy gets HTTPS certs for them) ──
API_DOMAIN=api.example.com
WEB_DOMAIN=app.example.com
ADMIN_DOMAIN=admin.example.com
# Image source: prebuilt images pulled from ghcr.io (built by CI).
# Pin a build with a git SHA, or leave default to track :latest.
IMAGE_TAG=latest

# ── App config (URLs the server trusts / links to) ──
CORS_ORIGIN=https://app.example.com,https://admin.example.com
WEB_URL=https://app.example.com
ADMIN_URL=https://admin.example.com
AUTH_EMAIL_FROM=noreply@example.com
ADMIN_EMAILS=you@example.com

# ── Secrets ──
# POSTGRES_PASSWORD goes into DATABASE_URL, so it must be URL-safe — NO + / = .
# Generate with: openssl rand -hex 24   (hex is always URL-safe)
POSTGRES_PASSWORD=change_me_hex_only
# These two never go in a URL, so + / = are fine: openssl rand -base64 48
AUTH_JWT_SECRET=change_me_32+_chars
CREDENTIALS_SECRET=change_me_32+_chars
RESEND_API_KEY=

# ── Attachments: R2 via its S3 API (stays on Cloudflare) ──
S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
S3_BUCKET=better-agent-uploads
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ── Invite gate: authz stays on Cloudflare Workers; reach it by public URL.
#    Leave AUTHZ_URL empty to disable the invite gate entirely. ──
AUTHZ_URL=
AUTHZ_SERVICE_SECRET=

# ── Optional Google OAuth ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Memory embeddings (SiliconFlow, OpenAI-compatible) ──
# Required for the memory system: memory add/search and the memory MCP tools
# reject with a clear "provider unavailable" error until this key is set.
# BASE_URL and MODEL are optional (defaults: https://api.siliconflow.cn/v1,
# BAAI/bge-m3 — a 1024-dim model matching the vector column).
SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=
EMBEDDING_MODEL=
