# Auto-HTTPS reverse proxy. Caddy fetches Let's Encrypt certs for each domain
# (the domains must resolve to this server and ports 80/443 be reachable).

{$API_DOMAIN} {
	reverse_proxy server:3000
}

{$WEB_DOMAIN} {
	reverse_proxy web:3000
}

{$ADMIN_DOMAIN} {
	reverse_proxy admin:3000
}

# MCP servers. These also run on Cloudflare Workers; point mcp_servers rows at
# either the Workers URL or these domains.
{$MCP_DOMAIN} {
	reverse_proxy mcp:3000
}

{$FINANCE_MCP_DOMAIN} {
	reverse_proxy finance-mcp:3000
}

{$WEREAD_MCP_DOMAIN} {
	reverse_proxy weread-mcp:3000
}
