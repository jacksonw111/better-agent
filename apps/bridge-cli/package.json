{
  "name": "@jacksonw111/better-agent-bridge",
  "version": "0.1.1",
  "description": "Bridge CLI that connects a local coding agent (claude-code, opencode, codex, pi) to a Better Agent server — relays events and approvals over oRPC.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacksonw111/better-agent.git",
    "directory": "apps/bridge-cli"
  },
  "homepage": "https://github.com/jacksonw111/better-agent/tree/main/apps/bridge-cli#readme",
  "bin": {
    "better-agent-bridge": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "@orpc/client": "catalog:"
  },
  "devDependencies": {
    "@better-agent/api": "workspace:*",
    "@better-agent/config": "workspace:*",
    "@orpc/server": "catalog:",
    "@types/node": "catalog:",
    "tsdown": "^0.21.9",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "4.1.9"
  }
}
