{
  "name": "@jacksonw111/better-agent-bridge",
  "version": "0.7.3",
  "description": "Better Agent client CLI — pairs a computer to a Better Agent server, reports runtime/skill/tool inventory, launches task runs in managed workspaces, and relays local coding agents (claude-code, opencode, codex, pi) over oRPC.",
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jacksonw111/better-agent.git",
    "directory": "apps/bridge-cli"
  },
  "homepage": "https://github.com/jacksonw111/better-agent/tree/main/apps/bridge-cli#readme",
  "bin": {
    "agent-cli": "./dist/index.mjs",
    "better-agent-bridge": "./dist/index.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "scripts": {
    "build": "tsdown",
    "compile": "bun build --compile --minify --target=bun-darwin-arm64 ./src/index.ts --outfile agent-cli",
    "check-types": "tsc -b",
    "dev": "tsx src/index.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.201",
    "@orpc/client": "catalog:",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@better-agent/agent": "workspace:*",
    "@better-agent/api": "workspace:*",
    "@better-agent/config": "workspace:*",
    "@orpc/server": "catalog:",
    "@types/node": "catalog:",
    "@types/ws": "^8.18.1",
    "tsdown": "^0.21.9",
    "tsx": "^4.19.2",
    "typescript": "catalog:",
    "vitest": "4.1.9"
  }
}
